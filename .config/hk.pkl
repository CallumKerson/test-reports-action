amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

min_hk_version = "2.4.0"

// mise verifies its lockfile and sidecar locks by digest, so formatting them breaks `mise install --locked`.
// tombi formats TOML and rumdl owns Markdown, so .oxfmtrc.json leaves both to them.
// aube writes package-lock.json, dist/ is generated by `mise run package`, release-please writes CHANGELOG.md,
// whose commit hashes typos reads as misspellings, and LICENSE is fixed legal text.
exclude = List(".config/mise.lock", ".config/mise/locks", "package-lock.json", "dist", "badges", "CHANGELOG.md", "LICENSE")

local linters = new Mapping<String, Step> {
    ["rumdl"] = Builtins.rumdl
    ["oxfmt"] = (Builtins.oxfmt) {
        check = "oxfmt --no-error-on-unmatched-pattern --check {{ files }}"
        check_list_files = "oxfmt --no-error-on-unmatched-pattern --list-different {{ files }}"
        fix = "oxfmt --no-error-on-unmatched-pattern --write {{ files }}"
    }
    ["oxlint"] = Builtins.ox_lint
    ["ryl"] = Builtins.ryl
    ["tombi"] = Builtins.tombi
    ["tombi_format"] = Builtins.tombi_format
    ["actionlint"] = Builtins.actionlint
    ["newlines"] = Builtins.newlines
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["typos"] = Builtins.typos
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
