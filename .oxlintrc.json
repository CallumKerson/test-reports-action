{
  "plugins": ["typescript", "import", "node"],
  "env": {
    "node": true,
    "es2022": true
  },
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "rules": {
    // With functions as consts, this would merge each module into one const
    "one-var": "off",
    // Conflicts with no-duplicate-imports
    "import/consistent-type-specifier-style": "off",
    // Conflict with import/no-default-export
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-nodejs-modules": "off",
    "no-magic-numbers": ["error", { "ignore": [0, 1] }],
    "node/no-process-env": "off"
  },
  "overrides": [
    {
      "files": ["__tests__/**", "__fixtures__/**", ".config/vitest.config.ts"],
      "plugins": ["vitest"],
      "rules": {
        // Conflicts with vitest/prefer-importing-vitest-globals
        "vitest/no-importing-vitest-globals": "off",
        "import/no-relative-parent-imports": "off",
        // Mocks mirror APIs that use undefined and take many parameters
        "no-undefined": "off",
        "max-params": "off",
        "no-magic-numbers": "off",
        "max-statements": "off"
      }
    },
    {
      "files": [
        ".config/vitest.config.ts",
        "tsdown.config.ts",
        "__fixtures__/artifact.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
