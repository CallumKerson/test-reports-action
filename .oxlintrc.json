{
  "plugins": ["typescript", "import", "node"],
  "env": {
    "node": true,
    "es2022": true
  },
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "error"
  },
  "rules": {
    // Each of these picks one of two equally good styles, and the code uses
    // the other one
    "capitalized-comments": "off", // wrapped comments continue in lower case
    "curly": "off",
    "func-style": "off", // functions are declared, not assigned
    "no-continue": "off",
    "no-ternary": "off",
    "one-var": "off",
    "sort-imports": "off", // packages, then node:, then local files
    "sort-keys": "off", // keys follow the shape of the data
    "init-declarations": "off", // set in hooks or try blocks
    "import/consistent-type-specifier-style": "off", // type imports are inline
    "import/exports-last": "off",
    "import/group-exports": "off",

    // These conflict: modules export named functions, so there is never a
    // single default to prefer
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",

    // @actions/* are used as namespaces, and an action runs on Node
    "import/no-namespace": "off",
    "import/no-nodejs-modules": "off",

    // Arbitrary limits that would split code for no reader's benefit
    "id-length": "off", // `_` and `i` in callbacks
    "max-params": "off", // mocks and helpers mirror the APIs they stand in for
    "max-statements": "off",
    "no-magic-numbers": "off" // test data, and units such as ms per second
  },
  "overrides": [
    {
      "files": ["__tests__/**", "__fixtures__/**", ".config/vitest.config.ts"],
      "plugins": ["vitest"],
      "rules": {
        // Tests import from vitest explicitly rather than using globals
        "vitest/no-importing-vitest-globals": "off",
        "vitest/no-hooks": "off",
        // Test names are sentences
        "vitest/prefer-lowercase-title": "off",
        // Every test already awaits what it asserts on
        "vitest/prefer-expect-assertions": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
