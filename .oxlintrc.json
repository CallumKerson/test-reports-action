{
  "plugins": ["typescript", "import", "node"],
  "env": {
    "node": true,
    "es2022": true
  },
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "rules": {
    // Each of these picks one of two equally good styles, and the code uses
    // the other one
    "capitalized-comments": "off", // wrapped comments continue in lower case
    "one-var": "off",

    // no-duplicate-imports wants one import from each module, so types are
    // imported inline, alongside the values from the same module
    "import/consistent-type-specifier-style": "off",
    // import/no-default-export is on, so modules export by name, which these
    // forbid, or ask for a default in place of
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",

    // An action runs on Node
    "import/no-nodejs-modules": "off",

    // Arbitrary limits that would split code for no reader's benefit
    "no-magic-numbers": "off", // test data, and units such as ms per second

    // An action reads its inputs and runner settings from the environment
    "node/no-process-env": "off"
  },
  "overrides": [
    {
      "files": ["__tests__/**", "__fixtures__/**", ".config/vitest.config.ts"],
      "plugins": ["vitest"],
      "rules": {
        // Conflicts with vitest/prefer-importing-vitest-globals, so tests
        // import from vitest rather than using globals
        "vitest/no-importing-vitest-globals": "off",
        // Tests import the source they test from ../src
        "import/no-relative-parent-imports": "off",
        // Mocks and stubbed environment variables stand for missing values with
        // undefined, as the APIs they stand in for do
        "no-undefined": "off",
        // Mocks mirror the APIs they stand in for
        "max-params": "off",
        // A describe block holds a statement for each of its tests
        "max-statements": "off"
      }
    },
    {
      // Config files must export a default, as must the mock of
      // @actions/artifact, which has one
      "files": [
        ".config/vitest.config.ts",
        "tsdown.config.ts",
        "__fixtures__/artifact.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
